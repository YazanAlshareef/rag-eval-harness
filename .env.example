# Copy to .env.local. Never commit .env.local.
# "fixture" = offline stand-in model, no key. "gemini" = real Gemini (needs a key here and a built Gemini index in the app).
LLM_PROVIDER=fixture
GEMINI_API_KEY=
# Where the RAG app lives (default: ../handbook-rag-chatbot)
RAG_APP_DIR=
# Model that grades answers in live runs
GEMINI_JUDGE_MODEL=gemini-2.5-flash
