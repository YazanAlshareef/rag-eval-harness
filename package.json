{
  "name": "rag-eval-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "replay": "tsx src/report.ts",
    "run": "tsx --env-file-if-exists=.env.local src/run.ts",
    "eval": "npm run run && npm run replay",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  },
  "engines": { "node": ">=22.13" }
}
